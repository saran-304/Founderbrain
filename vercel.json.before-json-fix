{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "services":  {
                     "api-server":  {
                                        "root":  "artifacts/api-server",
                                        "framework":  "express"
                                    },
                     "founderbrain-app":  {
                                              "root":  "artifacts/founderbrain-app",
                                              "framework":  "vite",
                                              "rewrites":  [
                                                               {
                                                                   "source":  "/(.*)",
                                                                   "destination":  "/index.html"
                                                               }
                                                           ],
                                              "outputDirectory":  "dist/public"
                                          }
                 },
    "rewrites":  [
                     {
                         "source":  "/api/(.*)",
                         "destination":  {
                                             "service":  "api-server"
                                         }
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  {
                                             "service":  "founderbrain-app"
                                         }
                     }
                 ]
}
