{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#FBF8F1" },
      "foreground": { "$value": "#2A2331" },
      "border": { "$value": "#E8E0D5" },
      "card": { "$value": "#FFFDF9" },
      "cardForeground": { "$value": "#2A2331" },
      "popover": { "$value": "#FFFDF9" },
      "popoverForeground": { "$value": "#2A2331" },
      "primary": {
        "$value": "#51327B",
        "$description": "Deep violet for primary actions, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#F0EADF" },
      "secondaryForeground": { "$value": "#332C3A" },
      "muted": { "$value": "#F4F0E9" },
      "mutedForeground": { "$value": "#706875" },
      "accent": {
        "$value": "#E7D7B1",
        "$description": "Soft champagne gold for small highlights, never large decorative surfaces."
      },
      "accentForeground": { "$value": "#302719" },
      "destructive": { "$value": "#A93343" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#DDD5CA" },
      "ring": { "$value": "#7855A3" },
      "chart1": { "$value": "#64438D" },
      "chart2": { "$value": "#C69B55" },
      "chart3": { "$value": "#356A9B" },
      "chart4": { "$value": "#5B8B70" },
      "chart5": { "$value": "#C27652" },
      "sidebar": { "$value": "#342048" },
      "sidebarForeground": { "$value": "#F8F3EA" },
      "sidebarBorder": { "$value": "#4C3760" },
      "sidebarPrimary": { "$value": "#DDBB73" },
      "sidebarPrimaryForeground": { "$value": "#281E31" },
      "sidebarAccent": { "$value": "#48315A" },
      "sidebarAccentForeground": { "$value": "#FFFDF9" },
      "sidebarRing": { "$value": "#E4CD97" }
    },
    "dark": {
      "background": { "$value": "#19151F" },
      "foreground": { "$value": "#F5F0E8" },
      "border": { "$value": "#403748" },
      "card": { "$value": "#221C29" },
      "cardForeground": { "$value": "#F5F0E8" },
      "popover": { "$value": "#2B2332" },
      "popoverForeground": { "$value": "#F5F0E8" },
      "primary": { "$value": "#C7A9F0" },
      "primaryForeground": { "$value": "#271A39" },
      "secondary": { "$value": "#352D3D" },
      "secondaryForeground": { "$value": "#F0EAE2" },
      "muted": { "$value": "#2D2634" },
      "mutedForeground": { "$value": "#BBAFC2" },
      "accent": { "$value": "#4D3B25" },
      "accentForeground": { "$value": "#F0CF85" },
      "destructive": { "$value": "#7F2F3C" },
      "destructiveForeground": { "$value": "#FFE6E9" },
      "input": { "$value": "#403748" },
      "ring": { "$value": "#D7BB82" },
      "chart1": { "$value": "#B89AE8" },
      "chart2": { "$value": "#E3BC74" },
      "chart3": { "$value": "#75A9D6" },
      "chart4": { "$value": "#83BA9B" },
      "chart5": { "$value": "#E09570" },
      "sidebar": { "$value": "#21172B" },
      "sidebarForeground": { "$value": "#F6F0E8" },
      "sidebarBorder": { "$value": "#3D2D49" },
      "sidebarPrimary": { "$value": "#E0BD75" },
      "sidebarPrimaryForeground": { "$value": "#2D2036" },
      "sidebarAccent": { "$value": "#352540" },
      "sidebarAccentForeground": { "$value": "#F6F0E8" },
      "sidebarRing": { "$value": "#D8B974" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "sans-serif"],
        "$description": "Crisp, highly legible interface and body type."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["Geist Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
